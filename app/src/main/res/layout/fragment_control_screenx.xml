<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.ControlScreen">

    <!-- HEADER SKIN -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="83dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/header_bg" >

        <ImageView
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/logo_header"
            android:contentDescription="@string/app_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/room_name_tv"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:text="Room name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BODY / CONTENT AREA -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/body_texture"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintVertical_bias="0.0">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_usb_1"
            style="@style/usb_source_button"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="90dp"
            app:iconTint="@null"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_marginStart="80dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/dirty_white"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_usb_2"
            style="@style/wireless_source_button"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="90dp"
            app:iconTint="@null"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_marginEnd="80dp"
            android:textColor="@color/dirty_white"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_usb_1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_power_off"
            style="@style/power_off_button"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:text="@string/power_off"
            android:textAllCaps="true"
            android:paddingTop="0dp"
            app:backgroundTint="@android:color/transparent"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="64dp"
            app:iconTint="@null"
            app:layout_constraintStart_toStartOf="@id/btn_usb_1"
            app:layout_constraintTop_toBottomOf="@id/btn_usb_1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_power_on"
            style="@style/power_on_button"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_marginEnd="80dp"
            android:text="@string/power_on"
            android:textAllCaps="true"
            android:paddingTop="0dp"
            app:backgroundTint="@android:color/transparent"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="64dp"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_power_off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_vol_down"
            style="@style/vol_down_button"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            app:backgroundTint="@android:color/transparent"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="64dp"
            app:iconTint="@null"
            app:layout_constraintStart_toStartOf="@id/btn_power_off"
            app:layout_constraintTop_toBottomOf="@id/btn_power_off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_vol_up"
            style="@style/vol_up_button"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_marginEnd="80dp"
            app:backgroundTint="@android:color/transparent"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="64dp"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_vol_down"/>

        <TextView
            android:id="@+id/volume_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volume"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/btn_vol_down"
            app:layout_constraintEnd_toStartOf="@+id/btn_vol_up"
            app:layout_constraintTop_toTopOf="@+id/btn_vol_down"
            app:layout_constraintBottom_toBottomOf="@id/btn_vol_down"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FOOTER SKIN -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/footer_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" >

        <ImageView
            android:id="@+id/switchLedIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/led_indicator"
            android:src="@drawable/ic_led" />

        <TextView
            android:id="@+id/switchLedIcon_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Switch is offline"
            android:textColor="@color/white"
            android:contentDescription="@string/connection_indicator_of_switch" />

        <View
            android:layout_width="24dp"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/tvLedIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/led_indicator"
            android:src="@drawable/ic_led" />

        <TextView
            android:id="@+id/tvLedDesc1_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="TV is offline"
            android:textColor="@color/white"
            android:contentDescription="@string/connection_indicator_of_TV" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit"
            style="@style/exit_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/exit_app"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_exit"
            app:iconGravity="start"
            app:iconPadding="0dp"

            />

    </LinearLayout>

    <!-- Warmup Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutWarmup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/warmupProgress"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintBottom_toTopOf="@+id/txtWarmupMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/txtWarmupMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/please_wait"
            android:textColor="@android:color/black"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/txtWarmupCountdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/warmupProgress" />

        <TextView
            android:id="@+id/txtWarmupCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="30s"
            android:textColor="@android:color/darker_gray"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtWarmupMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>