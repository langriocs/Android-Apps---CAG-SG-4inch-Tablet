<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashScreen">

    <activity
        android:id="@+id/mainActivity"
        android:name="com.avl.cagApp.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
    <fragment
        android:id="@+id/controlScreen"
        android:name="com.avl.cagApp.fragments.ControlScreen"
        android:label="fragment_control_screen"
        tools:layout="@layout/fragment_control_screen" >
        <action
            android:id="@+id/action_controlScreen_to_splashScreen"
            app:destination="@id/splashScreen" />
    </fragment>
    <fragment
        android:id="@+id/splashScreen"
        android:name="com.avl.cagApp.fragments.SplashScreen"
        android:label="fragment_splash_screen"
        tools:layout="@layout/fragment_splash_screen" >
        <action
            android:id="@+id/action_splashScreen_to_controlScreen"
            app:destination="@id/controlScreen" />
    </fragment>
</navigation>